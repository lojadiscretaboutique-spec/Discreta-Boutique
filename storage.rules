rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /{shopSegment}/videos/{storyId}/{fileName} {
      allow read: if shopSegment == "story-shop";
      allow write: if shopSegment == "story-shop" && signedIn();
    }

    match /{shopSegment}/thumbnails/{storyId}/{fileName} {
      allow read: if shopSegment == "story-shop";
      allow write: if shopSegment == "story-shop" && signedIn();
    }

    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /recruitment/{allPaths=**} {
      allow write: if true;
      allow read: if signedIn();
    }

    match /popups/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /combos/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /instagram/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /themes/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
