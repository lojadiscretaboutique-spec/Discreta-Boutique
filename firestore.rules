rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return signedIn() && (
        request.auth.uid == "VpnA7EDoSoUMF0VGOHyiCjyrOSf2" ||
        (
          "email" in request.auth.token && 
          request.auth.token.email == "lojadiscretaboutique@gmail.com"
        )
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function can(moduleName, action) {
      return true;
    }

    match /users/{uid} {
      allow read, write: if true;
    }

    match /customerOtpCodes/{uid} {
      allow read, write: if true;
    }

    match /mail/{doc=**} {
      allow read, write: if true;
    }

    match /roles/{doc} {
      allow read, write: if true;
    }

    match /products/{doc} {
      allow read, write: if true;
    }

    match /products/{productId}/variants/{variantId} {
      allow read, write: if true;
    }

    match /{path=**}/variants/{variantId} {
      allow read, write: if true; 
    }

    match /stockMovements/{doc} {
      allow read, write: if true;
    }

    match /inventoryBalances/{balanceId} {
      allow read, write: if true;
    }

    match /inventoryBalances/{balanceId}/items/{itemId} {
      allow read, write: if true;
    }

    match /inventoryBalances/{balanceId}/countEvents/{eventId} {
      allow read, write: if true;
    }

    match /categories/{doc} {
      allow read, write: if true;
    }

    match /banners/{doc} {
      allow read, write: if true;
    }

    match /home_section_settings/{doc} {
